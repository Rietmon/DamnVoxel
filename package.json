{
  "name": "damnvoxel",
  "description": "A voxel model editor in the browser, compatible with MagicaVoxel .vox",
  "keywords": [
    "voxel",
    "voxel-editor",
    "magicavoxel",
    "vox",
    "pwa",
    "webgl2"
  ],
  "license": "AGPL-3.0-or-later",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/build-site.ts && vite",
    "build": "node scripts/build-site.ts && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test-node.json",
    "lint": "biome check --error-on-warnings . && node scripts/check-layers.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "node scripts/check-bundle-size.ts",
    "test:coverage": "vitest run --coverage",
    "shot": "node scripts/shot.ts",
    "bench:mesher": "node scripts/bench-mesher.ts",
    "fixtures:vox": "node scripts/make-vox-fixtures.ts",
    "samples:vox": "node scripts/make-vox-samples.ts",
    "site": "node scripts/build-site.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
